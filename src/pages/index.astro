---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Particles from "@/components/Particles";
import { BentoGrid, BentoGridItem } from "@ph0n/theme-kit/ui";
import { links } from "@/constants/links";
---

<BaseLayout title="phon" description="My live projects, all in one place.">
  <div class="relative">
    <Particles
      client:load
      class="pointer-events-none absolute inset-0 animate-fade-in"
      quantity={80}
    />

    <main class="relative mx-auto max-w-4xl px-6 py-24">
      <section class="animate-fade-in">
        <h1
          class="font-display animate-title-glow text-4xl text-accent sm:text-5xl"
        >
          phon
        </h1>
        <p class="mt-4 max-w-xl text-muted-foreground">
          Here's what I'm making.
        </p>
      </section>

      <BentoGrid class="mt-12" client:visible>
        {
          links.map((link) => (
            <BentoGridItem
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              title={link.name}
              icon={link.icon}
            >
              {link.description}
            </BentoGridItem>
          ))
        }
      </BentoGrid>
    </main>
  </div>
</BaseLayout>
